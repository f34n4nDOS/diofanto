# Conexión a MySQL (formato SQLAlchemy + PyMySQL)
# Ejemplo: mysql+pymysql://usuario:contraseña@localhost:3306/diofanto
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/diofanto

# Clave secreta para firmar los JWT — generar una propia, nunca usar esta de ejemplo
# Se puede generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria

# Algoritmo de firma para JWT
ALGORITHM=HS256

# Minutos de validez del access token
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Pendientes de implementar (dejar comentadas hasta conectarlas) ----
# RESEND_API_KEY=
